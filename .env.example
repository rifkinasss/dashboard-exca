# Aplikasi
# Versi yang ditampilkan di aplikasi. Isi saat rilis ditetapkan.
APP_RELEASE_VERSION=
# Gunakan URL HTTPS production pada hosting.
SITE_URL=http://localhost:3000

# Autentikasi Google
# Samakan dengan SITE_URL. Daftarkan callback /api/auth/callback/google di Google OAuth.
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Daftar email admin utama, dipisahkan koma.
AUTH_GOOGLE_ALLOWED_EMAILS=

# Koneksi Google Sheets
# Pilihan sumber: google-sheets atau mock.
DASHBOARD_DATA_SOURCE=google-sheets
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Tulis dalam satu baris dengan \n sebagai pengganti baris baru.
GOOGLE_PRIVATE_KEY=
SHEETS_CACHE_TTL_SECONDS=60

# Worksheet
GOOGLE_SHEET_NAME="Overview Operasional"
# All Overview dapat dipilih untuk laporan gabungan.
GOOGLE_FINANCE_SHEET_NAME="Overview Finance"
# Input dan detail petak Oktober–Desember memakai tab 2026.
PLOT_OPERATIONAL_SHEET_NAME=2026
PLOT_PRICE_SHEET_NAME="Master Harga Petak"
# Penulis solar memerlukan nama worksheet pembelian dan harga yang sama.
FUEL_WITHDRAWAL_SHEET_NAME="Pengambilan Solar"
FUEL_PRICE_SHEET_NAME="Pengambilan Solar"
# Untuk mode testing, pilih nama worksheet testing secara eksplisit.
FUEL_TESTING_ONLY=false

# Google Drive Picker
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Izin penulisan
# Aktifkan di production setelah pengujian izin dan baca ulang.
ENABLE_PLOT_WRITES=false
ENABLE_FUEL_WITHDRAWAL_WRITES=false
ENABLE_FUEL_PRICE_WRITES=false
ENABLE_SPK_DOCUMENT_WRITES=false
ENABLE_SETTINGS_WRITES=false
